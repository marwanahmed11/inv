# Copy this file to .env.local and fill it in, then restart the server.

# Gmail notifications for new RSVPs use a Gmail "App Password" (not your normal password):
#   Google Account > Security > 2-Step Verification (turn on) > App passwords > create one.
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional: send notifications to a different address (defaults to GMAIL_USER)
RSVP_NOTIFY_TO=

# Password for the private wishes page at /admin, and the secret that signs the
# one-click Approve / Hide links in RSVP emails. Choose a long, unique password.
ADMIN_PASSWORD=

# Public address of the site once it is online (used in email links), e.g. https://mohamed-rawan.com
SITE_URL=
